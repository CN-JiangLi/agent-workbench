# Copy to .env.local (not committed). Used at **build** time for production static assets.
# Example: public API base (no trailing slash). App will call GET `${VITE_VISIT_API_URL}/api/visits?inc=1`
# （EdgeOne 等 CDN 对 POST 常返回 405，故使用 GET 递增；接口需返回 Cache-Control: no-store）
# VITE_VISIT_API_URL=https://your-stats.example.com

# Local dev: leave unset — `vitepress dev` serves /api/visits via middleware (writes server/data/home-visits.json).
# Optional: run `npm run visit-server` separately only if you need the counter on another port / non-Vite preview.

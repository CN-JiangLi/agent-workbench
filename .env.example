# Copy to .env.local (not committed). Used at **build** time for production static assets.
# Example: public API base (no trailing slash). App will call POST `${VITE_VISIT_API_URL}/api/visits`
# VITE_VISIT_API_URL=https://your-stats.example.com

# Local dev: leave unset — Vite proxies /api/visits → visit-server (run `npm run visit-server`).
